    {
      "parameters": {
        "jsCode": "\nconst itens = $input.all();\n\n// Objeto para agrupar os investimentos por cliente\nconst clientes = {};\n\nfor (const item of itens) {\n  const { nome, email, saldo, perfil, produto, minimo, rentabilidade } = item.json;\n\n  // Utiliza o email para identificar cada cliente\n  if (!clientes[email]) {\n    clientes[email] = {\n      nome,\n      email,\n      saldo,\n      perfil,\n      investimentos: []\n    };\n  }\n\n  // Adiciona cada investimento elegível ao cliente\n  clientes[email].investimentos.push({\n    produto,\n    minimo: Number(minimo),\n    rentabilidade\n  });\n}\n\n// Retorna um item por cliente com mensagem personalizada\nreturn Object.values(clientes).map(cliente => {\n\n  // Cria a lista dos produtos elegíveis\n  const produtos = cliente.investimentos\n    .map(investimento => investimento.produto)\n    .join(\", \");\n\n  // Define a mensagem conforme o perfil do cliente\n  const mensagens = {\n    Conservador: \"prioriza segurança e preservação do patrimônio\",\n    Moderado: \"busca equilíbrio entre segurança e rentabilidade\",\n    Arrojado: \"aceita maiores riscos em busca de rentabilidade\"\n  };\n\n  // Seleciona a descrição correspondente ao perfil\n  const descricao = mensagens[cliente.perfil] || \"possui um perfil de investimento a avaliar\";\n\n  // Gera a mensagem personalizada\n  cliente.mensagem = `Olá, ${cliente.nome}! Considerando seu perfil ${cliente.perfil.toLowerCase()}, que ${descricao}, e seu saldo de ${cliente.saldo}, identificamos os seguintes investimentos elegíveis: ${produtos || \"nenhum produto disponível\"}. Confira as condições e os riscos antes de investir.`;\n\n  // Retorna os dados do cliente\n  return {\n    json: cliente\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
